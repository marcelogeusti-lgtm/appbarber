{
  "name": "appbarber-server",
  "version": "1.0.0",
  "description": "Backend API for AppBarber Cloud SaaS",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "postinstall": "npx prisma@5 db push --accept-data-loss && npx prisma@5 generate",
    "db:migrate:deploy": "npx prisma@5 migrate deploy",
    "db:push": "npx prisma@5 db push",
    "db:backup": "node src/scripts/backup.js",
    "safety:snapshot": "node scripts/safety/create_snapshot.js",
    "safety:dump": "node scripts/safety/dump_database.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "barber",
    "saas",
    "express",
    "nodejs"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "firebase-admin": "^13.7.0",
    "googleapis": "^171.4.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "mercadopago": "^2.12.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "passkit-generator": "^3.2.0",
    "pg": "^8.11.0",
    "prisma": "^5.0.0",
    "qrcode": "^1.5.4",
    "resend": "^6.9.3",
    "socket.io": "^4.7.5",
    "speakeasy": "^2.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
