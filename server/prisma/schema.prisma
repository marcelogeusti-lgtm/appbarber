generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// VERSION_SYNC_TOKEN: a15f2136-PRISMA-HARDENING-03


// Enums
enum WaitlistStatus {
  WAITING
  NOTIFIED
  COMPLETED
  CANCELLED
}

enum PaymentGatewayStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  EXPIRED
}

enum PaymentMethodGateway {
  PIX
  CARD
}

enum TransactionOrigin {
  ONLINE
  PRESENCIAL
}

enum FinancialEventType {
  PAYMENT_CREATED
  PAYMENT_UPDATED
  PAYMENT_FAILED
  COMMISSION_GENERATED
  TRANSACTION_SYNCED
  ORDER_UPDATED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RECEPTIONIST
  BARBER
  BARBER_CONSULTA
  CLIENT
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

enum AppointmentStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  BOLETO
  SUBSCRIPTION
}

enum CommissionType {
  SERVICE
  PRODUCT
  SUBSCRIPTION
  EXTRA
}

enum CommissionStatus {
  PENDING
  PAID
}

enum OrderStatus {
  OPEN
  CLOSED
  PAID
  CANCELLED
}

// Models

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum OrderItemType {
  SERVICE
  PRODUCT
}

model AuthUser {
  id        String       @id @default(uuid())
  email     String       @unique
  password  String?
  provider  AuthProvider @default(EMAIL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  client    Client?
  user      User? // Professional User
  fcmTokens FcmToken[]
  sessions  Session[]

  twoFactorEnabled Boolean   @default(false)
  twoFactorMethod  String? // 'EMAIL' or 'SMS'
  twoFactorCode    String? // Temporary OTP code
  twoFactorExpires DateTime? // OTP Expiration
}

model Session {
  id         String   @id @default(uuid())
  authUserId String
  authUser   AuthUser @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  token      String   @unique
  deviceInfo String?
  ipAddress  String?
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())
}

model Client {
  id    String  @id @default(uuid())
  name  String
  phone String? @unique

  authUserId String?   @unique
  authUser   AuthUser? @relation(fields: [authUserId], references: [id], onDelete: SetNull)

  avatarUrl String?
  birthDate DateTime?
  gender    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  appointments  Appointment[]
  orders        Order[]
  subscriptions ClientSubscription[]
  noShowRecords NoShowRecord[]
  cardTokens    CardToken[]

  // Keep preferences/notifications?
  notifications Notification[]
  theme         String         @default("dark")
  active        Boolean        @default(true)
  cpf           String?        @unique
  cnpj          String?        @unique


  // Payment Gateway Customers (For Reusability)
  gatewayCustomers GatewayCustomer[]

  reviews   Review[]
  favorites FavoriteBarbershop[]

  addresses ClientAddress[]
  payments  Payment[]

  loyaltyBalances ClientLoyaltyBalance[]

  // Antigravity V3: Migration Bridges
  userIdLegacy String? 
}


// Phase 16: Credential Field Standardization [x]
// - [x] Add `Client ID` and `Client Secret` fields to `PaymentSettings.js`
// - [x] Update backend to prioritize `clientSecret` for webhook validation
// - [x] Sync production environment with UI updates

// Phase 17: Payment Foreign Key Fix [x]
// - [x] Add `clientId` and `client` relation to `Payment` model in `schema.prisma`
// - [x] Update `PaymentService` and `PaymentController` to distinguish between `User` (Staff) and `Client` (Customer)
// - [x] Apply schema changes with `prisma db push`
// - [x] Redeploy to Vercel and verify fix
model GatewayCustomer {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  gateway    String // mercadopago, stripe, velfy
  customerId String // The external customer ID (e.g. MP Payer ID)

  barbershopId String?
  barbershop   Barbershop? @relation(fields: [barbershopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, gateway, barbershopId]) // Scope per shop
}

model CardToken {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  gateway     String // mercadopago, stripe, velfy
  token       String // The tokenized card from gateway
  last4       String?
  brand       String?
  expiryMonth Int?
  expiryYear  Int?

  barbershopId String?
  barbershop   Barbershop? @relation(fields: [barbershopId], references: [id])

  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model User {
  id                  String    @id @default(uuid())
  name                String
  nickname            String?
  email               String?   @unique // Keep for legacy/lookup, but AuthUser handles login
  // password removed (moved to AuthUser) but kept optional for legacy during migration if needed, or just rely on AuthUser
  password            String?
  phone               String?   @unique
  landline            String?
  cpf                 String?   @unique
  cnpj                String?   @unique
  rg                  String?
  gender              String?
  birthday            DateTime?
  role                Role      @default(BARBER) // Primarily BARBER/ADMIN now
  avatarUrl           String?
  active              Boolean   @default(true)
  notes               String?   @db.Text
  tempPasswordExpires DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Link to AuthUser (Optional during migration)
  authUserId String?   @unique
  authUser   AuthUser? @relation(fields: [authUserId], references: [id], onDelete: SetNull)

  // Relations
  ownedBarbershops Barbershop[] @relation("BarbershopOwner")

  // If user is staff (Barber/Admin)
  workedBarbershopId String?
  workedBarbershop   Barbershop? @relation("BarbershopStaff", fields: [workedBarbershopId], references: [id])

  // If user is a professional (has specific profile)
  // LEGACY: Link to old professional profile (Phase 3 will migrate this to profilePro)
  professionalProfile Professional?

  // Pro Specific
  proAppointments     Appointment[]                   @relation("ProAppointments")
  commissions         Commission[]
  waitlistEntries     Waitlist[]                      @relation("ProWaitlist")
  professionalOrders  Order[]                         @relation("ProfessionalOrders")
  commissionOverrides ProfessionalServiceCommission[]

  // Notifications (Pro)
  notifications Notification[]
  theme         String         @default("dark")

  // Payment Orchestrator Relations
  payments              Payment[]
  externalSubscriptions SubscriptionExternal[]

  // System Updates Read
  readSystemUpdates UserSystemUpdateRead[]

  // Cash Shift Management
  openedShifts CashShift[] @relation("OpenedShifts")
  closedShifts CashShift[] @relation("ClosedShifts")

  auditLogs         AuditLog[]
  googleTokens      Json? // For Google Calendar OAuth2
  mpPayoutId        String? // For automated payment splits (Mercado Pago ID)
  enrolledCourses   UserCourse[]
  pushSubscriptions PushSubscription[]
  transactions      Transaction[]      @relation("ProTransactions")

  // Antigravity V3: Migration Bridges
  profileClient   ClientProfile? @relation("UserClientProfile")
  profilePro    ProfessionalProfile? @relation("UserProfessionalProfile")
}

model Notification {
  id String @id @default(uuid())

  // Generic User link (Pro)
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Client Link
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  title   String
  message String
  type    String // appointment, payment, order, system
  isRead  Boolean @default(false)
  status  String  @default("PENDING") // PENDING, SENT, FAILED

  appointmentId String?
  orderId       String?

  createdAt DateTime @default(now())
}

model EmailLog {
  id           String   @id @default(uuid())
  userId       String?  // Could be Client ID or User ID (Pro)
  email        String
  subject      String
  provider     String   @default("DEFAULT")
  status       String   @default("PENDING") // PENDING, SENT, FAILED
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
}

model Barbershop {
  id            String   @id @default(uuid())
  name          String
  commercialName String?
  legalName      String?
  slug          String   @unique
  address       String?
  street        String?
  number        String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  zipCode       String?
  country       String?  @default("Brasil")
  description   String?  @db.Text
  phone         String?
  logoUrl       String?
  bannerUrls    String[] @default([])
  webhookUrl    String?
  instagramUrl  String?
  facebookUrl   String?
  youtubeUrl    String?
  whatsappPhone String? // Sender number for notifications

  // Geolocalização
  latitude  Float?
  longitude Float?

  // No-Show Settings
  noShowEnabled Boolean @default(false)
  noShowPercent Float   @default(0)
  noShowText    String?

  subscriptionStatus    String?                @default("TRIAL")
  trialStartedAt        DateTime?              @default(now())
  trialEndsAt           DateTime?
  nextBillingDate       DateTime?
  saasPlan              String                 @default("SOLO")
  isTestAccount         Boolean                @default(false)

  // Cakto billing + retention flow (discount offered on cancel attempts)
  caktoSubscriptionId     String?
  retentionOffersUsed     Int       @default(0)
  retentionLastOfferAt    DateTime?
  retentionDiscountActive Boolean   @default(false)
  retentionOriginalAmount Float?
  enabledPaymentMethods PaymentMethod[] @default([CASH, PIX, CREDIT_CARD, DEBIT_CARD])

  // WhatsApp Automation Settings
  whatsappAutoReply         Boolean @default(false)
  whatsappKeywords          Json? // e.g. { "agendar": "Link de agendamento: {{link}}", "cancelar": "Instruções..." }
  whatsappBusinessHoursOnly Boolean @default(true)
  whatsappWelcomeMessage    String? @db.Text
  googleReviewLink          String? @db.Text
  whatsappStatus            String  @default("DISCONNECTED") // DISCONNECTED, CONNECTING, CONNECTED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("BarbershopOwner", fields: [ownerId], references: [id])

  staff             User[]             @relation("BarbershopStaff")
  services          Service[]
  products          Product[]
  appointments      Appointment[]
  transactions      Transaction[]
  waitlist          Waitlist[]
  subscriptionPlans SubscriptionPlan[]
  commissions       Commission[]
  orders            Order[]
  noShowRecords     NoShowRecord[]
  webhooks          Webhook[]
  gatewayConfigs    GatewayConfig[]
  cashShifts        CashShift[]
  payments          Payment[]
  gatewayCustomers  GatewayCustomer[]
  cardTokens        CardToken[]

  // Pix & PSP Settings
  pixKey       String? @map("pix_key")
  pixType      String? @map("pix_type") // email, cpf, cnpj, random
  pspProvider  String? @map("psp_provider") // mercadopago, asaas, manual
  pspAccountId String? @map("psp_account_id")

  featureFlags FeatureFlag[]
  auditLogs    AuditLog[]

  loyaltyProgram        LoyaltyProgram?
  reviews               Review[]
  favorites             FavoriteBarbershop[]
  notificationTemplates NotificationTemplate[]
  messageLogs           MessageLog[]
  banners               Banner[]

  loyaltyBalances       ClientLoyaltyBalance[]
}


model GatewayConfig {
  id           String     @id @default(uuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  gateway  String // STRIPE, MERCADOPAGO, VELFY
  isActive Boolean @default(false)

  // Stores API Keys, Access Tokens, Secrets as JSON
  // Ex: { publicKey: "...", secretKey: "..." }
  credentials Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barbershopId, gateway]) // One config per gateway per shop
}

enum NoShowStatus {
  PENDING
  CHARGED
  WAIVED
}

model NoShowRecord {
  id String @id @default(uuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  percentage Float
  baseValue  Float
  feeValue   Float

  status NoShowStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Professional {
  id       String  @id @default(uuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio      String?
  position String? // Cargo (Ex: Barbeiro Sênior, Auxiliar)

  // Visibility
  showInApp    Boolean @default(true)
  showPublicly Boolean @default(true)

  // Appointment settings
  appointmentInterval Int @default(30)

  // Address
  zipCode      String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  country      String? @default("Brasil")

  commissionPercent Float? @default(0)

  schedules Schedule[]
  services  Service[]
  serviceCommissions ProfessionalServiceCommission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum CommissionCalculationType {
  PERCENTAGE
  FIXED
}

model ProfessionalServiceCommission {
  id             String  @id @default(uuid())
  serviceId      String
  service        Service @relation(fields: [serviceId], references: [id])
  // FIX: Relacionamento transferido para o Professional e User mantido opcional p/ backward compatibility 
  professionalId   String?
  professionalUser User? @relation(fields: [professionalId], references: [id])
  
  professionalProfileId String?
  professionalProfile   Professional? @relation(fields: [professionalProfileId], references: [id])

  type  CommissionCalculationType
  value Decimal                   @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, professionalId])
}

model Service {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  duration    Int // Minutes
  active      Boolean @default(true)

  // Commission Config
  commissionType  CommissionCalculationType @default(PERCENTAGE)
  commissionValue Decimal                   @default(0) @db.Decimal(10, 2)

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  appointments      Appointment[]
  waitlist          Waitlist[]
  orderItems        OrderItem[]
  subscriptionPlans SubscriptionPlan[]

  commissionOverrides ProfessionalServiceCommission[]
  professionals       Professional[]

  isFeatured Boolean @default(false)
  imageUrl   String?
}

model Schedule {
  id             String       @id @default(uuid())
  dayOfWeek      Int // 0=Sunday, 1=Monday...
  startTime      String // "09:00"
  endTime        String // "18:00"
  breakStart     String? // "12:00"
  breakEnd       String? // "13:00"
  isOff          Boolean      @default(false)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
}

model Appointment {
  id          String            @id @default(uuid())
  date        DateTime
  status      AppointmentStatus @default(PENDING)
  notes       String?
  isSqueezeIn Boolean           @default(false)

  reminderMinutes Int? // Minutes before appointment to send reminder
  reminderSent    Boolean @default(false)

  // Linked to Client now
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  professionalId String
  professional   User   @relation("ProAppointments", fields: [professionalId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?

  transactions         Transaction[]
  commissions          Commission[]
  order                Order?
  noShowRecord         NoShowRecord?
  payments             Payment[]
  clientSubscriptionId String?
  clientSubscription   ClientSubscription? @relation(fields: [clientSubscriptionId], references: [id])

  review Review?


  @@index([barbershopId])
  @@index([professionalId])
  @@index([date])
  @@index([status])
  @@index([barbershopId, date, status])
  @@index([professionalId, date, status])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  costPrice   Decimal? @db.Decimal(10, 2)
  imageUrl    String?
  stock       Int      @default(0)
  active      Boolean  @default(true)
  isFeatured  Boolean  @default(false)

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String          @id @default(uuid())
  description String
  amount      Decimal         @db.Decimal(10, 2)
  type        TransactionType
  category    String? // Ex: Aluguel, Produto, Marketing
  date        DateTime        @default(now())

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  // New Relations
  orderId String?
  order   Order?  @relation("OrderTransactions", fields: [orderId], references: [id])

  // Financial V2 Fields
  paymentMethod String? // "PIX", "CREDIT_CARD", "MONEY", "DEBIT_CARD"
  origin        String? // "ONLINE" | "PRESENCIAL"

  professionalId String?
  professional   User?   @relation("ProTransactions", fields: [professionalId], references: [id])

  cashShiftId String?
  cashShift   CashShift? @relation(fields: [cashShiftId], references: [id])

  commissions Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([barbershopId])
  @@index([date])
  @@index([barbershopId, date, type])
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

model CashShift {
  id           String     @id @default(uuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  openedById String
  openedBy   User   @relation("OpenedShifts", fields: [openedById], references: [id], onDelete: Restrict)

  closedById String?
  closedBy   User?   @relation("ClosedShifts", fields: [closedById], references: [id], onDelete: Restrict)

  status CashShiftStatus @default(OPEN)

  openingBalance Float  @default(0)
  closingBalance Float?
  currentBalance Float  @default(0)

  openedAt DateTime  @default(now())
  closedAt DateTime?

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Waitlist {
  id          String   @id @default(uuid())
  clientName  String
  clientPhone String
  date        DateTime
  notes       String?
  status      WaitlistStatus @default(WAITING)

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  professionalId String?
  professional   User?   @relation("ProWaitlist", fields: [professionalId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// --- Subscription Module ---

enum SubscriptionStatus {
  PENDING
  ACTIVE
  OVERDUE
  CANCELLED
  INACTIVE
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String
  description  String?
  benefits     String[] // List of benefits e.g. ["4 cortes", "10% off"]
  price        Decimal  @db.Decimal(10, 2)
  validityDays Int      @default(30)

  // Credits (Optional for Phase 2)
  quantityOfCuts Int? @default(0)

  allowedMethods PaymentMethod[] // Which methods the barber accepts for this plan

  active Boolean @default(true)

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  isRecurring Boolean @default(false) @map("is_recurring")
  externalId  String? @map("external_id") // ID do plano no Gateway (MP)

  clientSubscriptions ClientSubscription[]
  services            Service[] // Services included/applicable

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientSubscription {
  id String @id @default(uuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  planId String
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(PENDING)

  startDate       DateTime  @default(now())
  endDate         DateTime
  nextBillingDate DateTime?

  remainingCuts Int? @default(0) // If plan has credit logic

  paymentMethod PaymentMethod?
  externalId    String? // Subscription ID in gateway

  appointments Appointment[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Commission {
  id String @id @default(uuid())

  barberId String
  barber   User   @relation(fields: [barberId], references: [id])

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  type        CommissionType
  description String?
  amount      Float
  percentage  Float?
  status      CommissionStatus @default(PENDING)

  paidAt    DateTime?
  createdAt DateTime  @default(now())
}

model Order {
  id String @id @default(uuid())

  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  professionalId String
  professional   User   @relation("ProfessionalOrders", fields: [professionalId], references: [id])

  status OrderStatus @default(OPEN)

  subtotal Float @default(0)
  discount Float @default(0)
  total    Float @default(0)

  paymentMethod PaymentMethod?
  paymentStatus PaymentStatus  @default(PENDING)
  paidAt        DateTime?

  notes String?

  items OrderItem[]

  // Payment Orchestrator Relation
  payments Payment[]

  // Cash Flow Integration
  cashTransactions Transaction[] @relation("OrderTransactions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@index([barbershopId])
  @@index([status])
  @@index([barbershopId, updatedAt, status])
  @@index([barbershopId, createdAt])
}


model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type String // "SERVICE" or "PRODUCT"

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  quantity  Int   @default(1)
  unitPrice Float
  total     Float

  createdAt DateTime @default(now())
}

model Webhook {
  id     String   @id @default(uuid())
  url    String
  secret String?
  events String[] // e.g. ["payment.approved", "whatsapp.received"]
  active Boolean  @default(true)

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommunicationLog {
  id           String   @id @default(uuid())
  barbershopId String
  clientId     String
  channel      String?
  direction    String?
  type         String?
  content      String?
  status       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([barbershopId, createdAt])
}

// --- Payment Orchestrator Models ---

model Payment {
  id         String  @id @default(uuid())
  gateway    String // mercadopago | stripe | velfy
  method     String // pix | card
  externalId String? @map("external_id")
  status       String // pending | paid | failed | canceled | expired
  statusDetail String? @map("status_detail")
  amount     Decimal @db.Decimal(10, 2)
  currency   String  @default("BRL")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id])

  // Relations to context
  barbershopId String?     @map("barbershop_id")
  barbershop   Barbershop? @relation(fields: [barbershopId], references: [id])

  appointmentId String?      @map("appointment_id")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  clientSubscriptionId String?             @map("client_subscription_id")
  clientSubscription   ClientSubscription? @relation(fields: [clientSubscriptionId], references: [id])

  // Pix Specifics
  qrCode        String? @map("qr_code") @db.Text
  qrCodeBase64  String? @map("qr_code_base64") @db.Text
  pixCopiaECola String? @map("pix_copia_cola") @db.Text
  ticketUrl     String? @map("ticket_url") @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  paidAt    DateTime? @map("paid_at")

  @@map("payments")
}

model SubscriptionExternal {
  id         String @id @default(uuid())
  gateway    String // stripe | mercadopago | velfy
  externalId String @map("external_subscription_id")
  status     String // active | past_due | canceled
  plan       String // monthly | yearly

  userId String @map("user_id")
  user   User?  @relation(fields: [userId], references: [id])

  startedAt DateTime @map("started_at")
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriptions_external")
}

model LoyaltyProgram {
  id           String     @id @default(uuid())
  barbershopId String     @unique
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  active            Boolean @default(false)
  pointsPerReal     Float   @default(1) // How many points per currency unit
  rewardDescription String?
  minPointsToRedeem Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id      String  @id @default(uuid())
  rating  Int // 1-5
  comment String? @db.Text

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FavoriteBarbershop {
  id String @id @default(uuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  createdAt DateTime @default(now())

  @@unique([clientId, barbershopId])
}

model WebhookLog {
  id        String   @id @default(uuid())
  gateway   String // stripe | mercadopago | velfy
  event     String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("webhook_logs")
}

// --- Master / Educational Platform Models ---

model Course {
  id           String  @id @default(uuid())
  title        String
  description  String? @db.Text
  thumbnailUrl String?
  link         String  @db.Text // Affiliate Link
  category     String? // e.g. "Marketing", "Técnica", "Gestão"
  duration     String? // e.g. "4h 30m"
  active       Boolean @default(true)

  order Int @default(0) // Display order

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrolledUsers UserCourse[]
}

model UserCourse {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Banner {
  id       String  @id @default(uuid())
  title    String?
  imageUrl String
  linkUrl  String?
  ctaText  String? // "Saiba mais", "Comprar", etc.

  startDate DateTime?
  endDate   DateTime?
  active    Boolean   @default(true)

  location String @default("DASHBOARD_TOP") // DASHBOARD_TOP, SIDEBAR, ETC

  barbershopId String?
  barbershop   Barbershop? @relation(fields: [barbershopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UpdateType {
  INFO
  WARNING
  CRITICAL
}

model SystemUpdate {
  id          String     @id @default(uuid())
  version     String?
  title       String
  description String     @db.Text
  type        UpdateType @default(INFO)

  startDate DateTime @default(now())
  active    Boolean  @default(true)

  requiresConfirmation Boolean @default(false)

  readBy UserSystemUpdateRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSystemUpdateRead {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  systemUpdateId String
  systemUpdate   SystemUpdate @relation(fields: [systemUpdateId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@unique([userId, systemUpdateId])
}

enum SaaSSubscriptionStatus {
  TRIAL
  ACTIVE
  OVERDUE
  CANCELLED
  BLOCKED
}

model FeatureFlag {
  id           String      @id @default(uuid())
  key          String
  description  String?
  enabled      Boolean     @default(false)
  
  // New expressivity fields
  allowedPlans String[] @default([]) // e.g. ["PRO", "ENTERPRISE"]
  allowedUsers String[] @default([]) // IDs of specific test barbershops or users

  barbershopId String? // Optional: Enable for specific tenant (null for global)
  barbershop   Barbershop? @relation(fields: [barbershopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, barbershopId])
  @@index([barbershopId])
}

model AuditLog {
  id      String  @id @default(uuid())
  actorId String? // User who performed the action
  actor   User?   @relation(fields: [actorId], references: [id])

  action   String // e.g. "UPDATE_PRICE", "DELETE_APPOINTMENT"
  entity   String // e.g. "Service", "Appointment"
  entityId String?

  oldData Json?
  newData Json?

  barbershopId String?
  barbershop   Barbershop? @relation(fields: [barbershopId], references: [id])

  ipAddress String?
  userAgent String?

  timestamp DateTime @default(now())

  @@index([barbershopId])
  @@index([actorId])
  @@index([entity, entityId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model FcmToken {
  id         String   @id @default(uuid())
  token      String   @unique
  authUserId String
  authUser   AuthUser @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  deviceType String? // ios, android, web
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([authUserId])
}

model NotificationTemplate {
  id           String      @id @default(uuid())
  barbershopId String? // Null for Global templates
  barbershop   Barbershop? @relation(fields: [barbershopId], references: [id])

  name    String? // Friendly name
  type    String // appointment_confirmed, appointment_cancelled, etc.
  content String  @db.Text
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([barbershopId, type])
}

model ClientAddress {
  id       String @id @default(uuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  zipCode      String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  country      String  @default("Brasil")

  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model Tutorial {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  url         String   @db.Text
  category    String
  duration    String?
  status      String   @default("published")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// --- Loyalty Tracking ---
model ClientLoyaltyBalance {
  id           String     @id @default(uuid())
  clientId     String
  client       Client     @relation(fields: [clientId], references: [id])
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  points       Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ledgers LoyaltyLedger[]

  @@unique([clientId, barbershopId])
  @@map("client_loyalty_balance")
}

model LoyaltyLedger {
  id                 String               @id @default(uuid())
  clientLoyaltyId    String
  clientLoyalty      ClientLoyaltyBalance @relation(fields: [clientLoyaltyId], references: [id], onDelete: Cascade)
  type               String // "EARN", "REDEEM", "ADJUST"
  points             Int // +10 or -10
  description        String?
  transactionId      String? // Reference to the app Transaction or Appointment
  createdAt          DateTime             @default(now())

  @@map("loyalty_ledger")
}

model ClientProfile {
  id        String   @id @default(uuid())
  user      User     @relation("UserClientProfile", fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProfessionalProfile {
  id        String   @id @default(uuid())
  user      User     @relation("UserProfessionalProfile", fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MessageLog {
  id           String   @id @default(uuid())
  type         String   // "WHATSAPP", "EMAIL", "PUSH"
  recipient    String   // Phone or email address
  body         String   @db.Text
  status       String   // "PENDING", "SENT", "FAILED"
  error        String?  @db.Text
  
  barbershopId String?
  barbershop   Barbershop? @relation(fields: [barbershopId], references: [id])
  
  createdAt    DateTime @default(now())
}

model FinancialEvent {
  id          String             @id @default(uuid())
  type        FinancialEventType
  referenceId String?            
  
  barbershopId String
  userId       String?

  payload     Json?              
  processed   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  
  @@index([type, processed])
  @@index([referenceId])
  @@index([barbershopId])
}



model PlatformSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Audit trail of SaaS billing webhooks (Cakto etc.)
model SaasWebhookEvent {
  id        String   @id @default(uuid())
  gateway   String
  event     String?
  email     String?
  productId String?
  raw       Json
  processed Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([processed])
}
