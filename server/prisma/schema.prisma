generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums
enum Role {
  SUPER_ADMIN
  ADMIN
  BARBER
  BARBER_CONSULTA
  CLIENT
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  SUBSCRIPTION
}

enum CommissionType {
  SERVICE
  PRODUCT
  SUBSCRIPTION
  EXTRA
}

enum CommissionStatus {
  PENDING
  PAID
}

enum OrderStatus {
  OPEN
  CLOSED
  PAID
  CANCELLED
}

// Models

model AuthUser {
  id        String       @id @default(uuid())
  email     String       @unique
  password  String?
  provider  AuthProvider @default(EMAIL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  client    Client?
  user      User?    // Professional User
}

model Client {
  id          String   @id @default(uuid())
  name        String
  phone       String?  @unique
  
  authUserId  String?   @unique
  authUser    AuthUser? @relation(fields: [authUserId], references: [id])
  
  avatarUrl   String?
  birthDate   DateTime?
  gender      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]
  orders       Order[]
  subscriptions ClientSubscription[]
  noShowRecords NoShowRecord[]
  
  appointments Appointment[]
  orders       Order[]
  subscriptions ClientSubscription[]
  noShowRecords NoShowRecord[]
  cardTokens    CardToken[]
  
  // Keep preferences/notifications?
  notifications Notification[]
  theme         String @default("dark")
}

model CardToken {
  id            String   @id @default(uuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  
  gateway       String   // mercadopago, stripe, velify
  token         String   // The tokenized card from gateway
  last4         String?
  brand         String?
  expiryMonth   Int?
  expiryYear    Int?
  
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
}

model User {
  id        String   @id @default(uuid())
  name      String
  nickname  String?
  email     String?  @unique // Keep for legacy/lookup, but AuthUser handles login
  // password removed (moved to AuthUser) but kept optional for legacy during migration if needed, or just rely on AuthUser
  password  String? 
  phone     String?  @unique
  landline  String?
  cpf       String?  @unique
  cnpj      String?  @unique
  rg        String?
  gender    String?
  birthday  DateTime?
  role      Role     @default(BARBER) // Primarily BARBER/ADMIN now
  avatarUrl String?
  active    Boolean  @default(true)
  notes     String?  @db.Text
  tempPasswordExpires DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Link to AuthUser (Optional during migration)
  authUserId String?   @unique
  authUser   AuthUser? @relation(fields: [authUserId], references: [id])

  // Relations
  ownedBarbershops Barbershop[] @relation("BarbershopOwner")
  
  // If user is staff (Barber/Admin)
  workedBarbershopId String?
  workedBarbershop   Barbershop? @relation("BarbershopStaff", fields: [workedBarbershopId], references: [id])
  
  // If user is a professional (has specific profile)
  professionalProfile Professional?

  // Pro Specific
  proAppointments    Appointment[] @relation("ProAppointments")
  commissions        Commission[]
  waitlistEntries    Waitlist[] @relation("ProWaitlist")
  professionalOrders Order[] @relation("ProfessionalOrders")
  commissionOverrides ProfessionalServiceCommission[]
  
  // Notifications (Pro)
  notifications Notification[]
  theme         String @default("dark")

  // Payment Orchestrator Relations
  payments              Payment[]
  externalSubscriptions SubscriptionExternal[]

  // System Updates Read
  readSystemUpdates     UserSystemUpdateRead[]

  // Cash Shift Management
  openedShifts          CashShift[] @relation("OpenedShifts")
  closedShifts          CashShift[] @relation("ClosedShifts")
}

model Notification {
  id        String   @id @default(uuid())
  
  // Generic User link (Pro)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  
  // Client Link
  clientId  String?
  client    Client?   @relation(fields: [clientId], references: [id])

  title     String
  message   String
  type      String   // appointment, payment, order, system
  isRead    Boolean  @default(false)
  
  appointmentId String?
  orderId       String?

  createdAt DateTime @default(now())
}

model Barbershop {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  address   String?
  phone     String?
  logoUrl   String?
  bannerUrls String[] @default([])
  webhookUrl String?
  whatsappPhone String? // Sender number for notifications

  // Geolocalização
  latitude  Float?
  longitude Float?
  
  // No-Show Settings
  noShowEnabled Boolean @default(false)
  noShowPercent Float   @default(0)
  noShowText    String?
  
  subscriptionStatus String @default("ACTIVE") // ACTIVE, OVERDUE, CANCELED
  saasPlan       String @default("BASIC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String
  owner     User     @relation("BarbershopOwner", fields: [ownerId], references: [id])

  staff     User[]   @relation("BarbershopStaff")
  services  Service[]
  products  Product[]
  appointments Appointment[]
  transactions Transaction[]
  waitlist     Waitlist[]
  subscriptionPlans SubscriptionPlan[]
  commissions  Commission[]
  orders       Order[]
  noShowRecords NoShowRecord[]
  webhooks     Webhook[]
  gatewayConfigs GatewayConfig[]
  cashShifts   CashShift[]
}

model GatewayConfig {
  id            String   @id @default(uuid())
  barbershopId  String
  barbershop    Barbershop @relation(fields: [barbershopId], references: [id])
  
  gateway       String   // STRIPE, MERCADOPAGO, VELIFY
  isActive      Boolean  @default(false)
  
  // Stores API Keys, Access Tokens, Secrets as JSON
  // Ex: { publicKey: "...", secretKey: "..." }
  credentials   Json
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([barbershopId, gateway]) // One config per gateway per shop
}

enum NoShowStatus {
  PENDING
  CHARGED
  WAIVED
}

model NoShowRecord {
  id            String   @id @default(uuid())
  
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  
  appointmentId String   @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  
  barbershopId  String
  barbershop    Barbershop @relation(fields: [barbershopId], references: [id])
  
  percentage    Float
  baseValue     Float
  feeValue      Float
  
  status        NoShowStatus @default(PENDING)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Professional {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  bio       String?
  position  String? // Cargo (Ex: Barbeiro Sênior, Auxiliar)
  
  // Visibility
  showInApp     Boolean @default(true)
  showPublicly  Boolean @default(true)
  
  // Appointment settings
  appointmentInterval Int @default(30)
  
  // Address
  zipCode      String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  country      String? @default("Brasil")

  commissionPercent Float? @default(0)

  schedules Schedule[]
  services  Service[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum CommissionCalculationType {
  PERCENTAGE
  FIXED
}

model ProfessionalServiceCommission {
  id             String @id @default(uuid())
  serviceId      String
  service        Service @relation(fields: [serviceId], references: [id])
  professionalId String
  professional   User    @relation(fields: [professionalId], references: [id])
  
  type           CommissionCalculationType
  value          Decimal @db.Decimal(10, 2)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([serviceId, professionalId])
}

model Service {
  id           String @id @default(uuid())
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  duration     Int      // Minutes
  active       Boolean  @default(true)
  
  // Commission Config
  commissionType  CommissionCalculationType @default(PERCENTAGE)
  commissionValue Decimal                   @default(0) @db.Decimal(10, 2)
  
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  appointments Appointment[]
  waitlist     Waitlist[]
  orderItems   OrderItem[]
  subscriptionPlans SubscriptionPlan[]
  
  commissionOverrides ProfessionalServiceCommission[]
  professionals       Professional[]
}

model Schedule {
  id             String @id @default(uuid())
  dayOfWeek      Int    // 0=Sunday, 1=Monday...
  startTime      String // "09:00"
  endTime        String // "18:00"
  breakStart     String? // "12:00"
  breakEnd       String? // "13:00"
  isOff          Boolean @default(false)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
}

model Appointment {
  id        String   @id @default(uuid())
  date      DateTime
  status    AppointmentStatus @default(PENDING)
  notes     String?
  isSqueezeIn Boolean @default(false)
  
  reminderMinutes Int? // Minutes before appointment to send reminder
  reminderSent    Boolean @default(false)
  
  // Linked to Client now
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])

  professionalId String
  professional   User     @relation("ProAppointments", fields: [professionalId], references: [id])

  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod?

  transactions Transaction[]
  commissions  Commission[]
  order        Order?
  noShowRecord NoShowRecord?
  clientSubscriptionId String?
  clientSubscription ClientSubscription? @relation(fields: [clientSubscriptionId], references: [id])

  @@index([professionalId])
  @@index([date])
  @@index([status])
  @@index([professionalId, date, status])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  costPrice   Decimal? @db.Decimal(10, 2)
  stock       Int      @default(0)
  active      Boolean  @default(true)
  
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  
  orderItems   OrderItem[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id           String   @id @default(uuid())
  description  String
  amount       Decimal  @db.Decimal(10, 2)
  type         TransactionType
  category     String?  // Ex: Aluguel, Produto, Marketing
  date         DateTime @default(now())
  
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  // New Relations
  orderId       String?
  order         Order?       @relation("OrderTransactions", fields: [orderId], references: [id])
  
  cashShiftId   String?
  cashShift     CashShift?   @relation(fields: [cashShiftId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

model CashShift {
  id              String   @id @default(uuid())
  barbershopId    String
  barbershop      Barbershop @relation(fields: [barbershopId], references: [id])
  
  openedById      String
  openedBy        User     @relation("OpenedShifts", fields: [openedById], references: [id])
  
  closedById      String?
  closedBy        User?    @relation("ClosedShifts", fields: [closedById], references: [id])
  
  status          CashShiftStatus @default(OPEN)
  
  openingBalance  Float    @default(0)
  closingBalance  Float?
  currentBalance  Float    @default(0)
  
  openedAt        DateTime @default(now())
  closedAt        DateTime?
  
  transactions    Transaction[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Waitlist {
  id           String   @id @default(uuid())
  clientName   String
  clientPhone  String
  date         DateTime
  notes        String?
  status       String   @default("WAITING") // WAITING, NOTIFIED, COMPLETED, CANCELLED

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  serviceId    String
  service      Service    @relation(fields: [serviceId], references: [id])

  professionalId String?
  professional   User?      @relation("ProWaitlist", fields: [professionalId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

// --- Subscription Module ---

enum SubscriptionStatus {
  PENDING
  ACTIVE
  OVERDUE
  CANCELLED
  INACTIVE
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  name          String
  description   String?
  benefits      String[] // List of benefits e.g. ["4 cortes", "10% off"]
  price         Decimal  @db.Decimal(10, 2)
  validityDays  Int      @default(30)
  
  // Credits (Optional for Phase 2)
  quantityOfCuts Int?    @default(0)
  
  allowedMethods PaymentMethod[] // Which methods the barber accepts for this plan
  
  active        Boolean  @default(true)
  
  barbershopId  String
  barbershop    Barbershop @relation(fields: [barbershopId], references: [id])
  
  clientSubscriptions ClientSubscription[]
  services            Service[] // Services included/applicable
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ClientSubscription {
  id              String   @id @default(uuid())
  
  clientId        String
  client          Client     @relation(fields: [clientId], references: [id])
  
  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  
  status          SubscriptionStatus @default(PENDING)
  
  startDate       DateTime @default(now())
  endDate         DateTime
  nextBillingDate DateTime?
  
  remainingCuts   Int?    @default(0) // If plan has credit logic
  
  paymentMethod   PaymentMethod?
  externalId      String?  // Subscription ID in gateway
  
  appointments    Appointment[]
  payments        Payment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Commission {
  id              String   @id @default(uuid())
  
  barberId        String
  barber          User     @relation(fields: [barberId], references: [id])
  
  barbershopId    String
  barbershop      Barbershop @relation(fields: [barbershopId], references: [id])
  
  appointmentId   String?
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])
  
  type            CommissionType
  description     String?
  amount          Float
  percentage      Float?
  status          CommissionStatus @default(PENDING)
  
  paidAt          DateTime?
  createdAt       DateTime @default(now())
}

model Order {
  id              String   @id @default(uuid())
  
  appointmentId   String?  @unique
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])
  
  barbershopId    String
  barbershop      Barbershop @relation(fields: [barbershopId], references: [id])
  
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  
  professionalId  String
  professional    User     @relation("ProfessionalOrders", fields: [professionalId], references: [id])
  
  status          OrderStatus @default(OPEN)
  
  subtotal        Float    @default(0)
  discount        Float    @default(0)
  total           Float    @default(0)
  
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus @default(PENDING)
  paidAt          DateTime?
  
  notes           String?
  
  items           OrderItem[]
  
  // Payment Orchestrator Relation
  payments        Payment[]

  // Cash Flow Integration
  cashTransactions Transaction[] @relation("OrderTransactions")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  type        String   // "SERVICE" or "PRODUCT"
  
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  
  quantity    Int      @default(1)
  unitPrice   Float
  total       Float
  
  createdAt   DateTime @default(now())
}

model Webhook {
  id           String   @id @default(uuid())
  url          String
  secret       String?
  events       String[] // e.g. ["payment.approved", "whatsapp.received"]
  active       Boolean  @default(true)
  
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CommunicationLog {
  id           String   @id @default(uuid())
  barbershopId String
  clientId     String
  channel      String?
  direction    String?
  type         String?
  content      String?
  status       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- Payment Orchestrator Models ---

model Payment {
  id              String   @id @default(uuid())
  gateway         String   // mercadopago | stripe | velify
  method          String   // pix | card
  externalId      String?  @map("external_id")
  status          String   // pending | paid | failed | canceled
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("BRL")
  
  userId          String?  @map("user_id")
  user            User?    @relation(fields: [userId], references: [id])
  
  // Optional: Link to existing models for compatibility
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id]) 

  clientSubscriptionId String?  @map("client_subscription_id")
  clientSubscription   ClientSubscription? @relation(fields: [clientSubscriptionId], references: [id])

  createdAt       DateTime @default(now()) @map("created_at")
  paidAt          DateTime? @map("paid_at")

  @@map("payments")
}

model SubscriptionExternal {
  id              String   @id @default(uuid())
  gateway         String   // stripe | mercadopago | velify
  externalId      String   @map("external_subscription_id")
  status          String   // active | past_due | canceled
  plan            String   // monthly | yearly
  
  userId          String   @map("user_id")
  user            User?    @relation(fields: [userId], references: [id])
  
  startedAt       DateTime @map("started_at")
  expiresAt       DateTime @map("expires_at")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("subscriptions_external")
}

model WebhookLog {
  id              String   @id @default(uuid())
  gateway         String   // stripe | mercadopago | velify
  event           String
  payload         Json
  processed       Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("webhook_logs")
}

// --- Master / Educational Platform Models ---

model Course {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  thumbnailUrl String?
  link        String   @db.Text // Affiliate Link
  category    String?  // e.g. "Marketing", "Técnica", "Gestão"
  active      Boolean  @default(true)
  
  order       Int      @default(0) // Display order

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Banner {
  id          String   @id @default(uuid())
  title       String?
  imageUrl    String
  linkUrl     String?
  ctaText     String?  // "Saiba mais", "Comprar", etc.
  
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean  @default(true)
  
  location    String   @default("DASHBOARD_TOP") // DASHBOARD_TOP, SIDEBAR, ETC
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum UpdateType {
  INFO
  WARNING
  CRITICAL
}

model SystemUpdate {
  id          String   @id @default(uuid())
  version     String?
  title       String
  description String   @db.Text
  type        UpdateType @default(INFO)
  
  startDate   DateTime @default(now())
  active      Boolean  @default(true)
  
  requiresConfirmation Boolean @default(false)

  readBy      UserSystemUpdateRead[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserSystemUpdateRead {
  id             String   @id @default(uuid())
  
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  systemUpdateId String
  systemUpdate   SystemUpdate @relation(fields: [systemUpdateId], references: [id], onDelete: Cascade)
  
  readAt         DateTime @default(now())

  @@unique([userId, systemUpdateId])
}
