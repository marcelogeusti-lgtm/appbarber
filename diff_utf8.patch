+                    await notificationController.createNotification({
+                        userId: appointment.professionalId,
+                        title: 'Agendamento Cancelado',
+                        message: `O agendamento de ${appointment.client?.name || 'Cliente'} para as ${format(new Date(appointment.date), 'HH:mm')} foi cancelado. O hor├írio est├í liberado.`,
+                        type: 'cancellation',
