+
+                        <div className="p-6 space-y-4 relative min-h-[300px]">
+                            {isSuccess ? (
+                                <div className="absolute inset-0 bg-[#111] z-20 flex flex-col items-center justify-center space-y-6 animate-in zoom-in-95 duration-500">
