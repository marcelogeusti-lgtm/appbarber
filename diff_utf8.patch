+
+    async function checkFavoriteStatus(id) {
+        try {
+            if (!localStorage.getItem('clientToken')) return;
+            const res = await api.get(`/barbershops/${id}/favorite-status`);
+            setIsFavorite(res.data.favorited);
+        } catch (err) {
