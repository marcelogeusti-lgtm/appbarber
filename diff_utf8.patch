+            {/* --- PLANS LIST --- */}
+            {plans.length > 0 ? (
+                plans.map((plan) => (
+                    <div key={plan.id} className="bg-gradient-to-br from-[#1A1A1A] to-[#0A0A0A] p-[1px] rounded-[2.5rem] border border-primary/10 hover:border-primary/30 transition group">
